# Files/directories to exclude from Docker build context
# Keeping the context small speeds up 'docker build' and 'az acr build'

# Dependency directories (always reinstalled inside Docker)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development / local config
.env
.env.*
*.local

# Version control
.git/
.gitignore

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# macOS artifacts
.DS_Store
Thumbs.db

# Test files (not needed in the image)
__tests__/
*.test.js
*.spec.js
coverage/

# Documentation
*.md
